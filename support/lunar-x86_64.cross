[host_machine]
system = 'lunar'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[binaries]
c = ['clang', '--target=x86_64-unknown-lunar']
cpp = ['clang++', '--target=riscv64-unknown-lunar']
c_ld = 'lld'
ar = 'llvm-ar'
strip = 'llvm-strip'
ld = 'x86_64-lunar-ld'

[properties]
needs_exe_wrapper = true
